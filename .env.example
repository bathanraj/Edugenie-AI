# Copy this file to ".env" and fill in your key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Set to true to run the local LaMini-Flan-T5-783M model for /explain
# (requires: pip install transformers torch sentencepiece). Falls back to Gemini on failure.
USE_LOCAL_EXPLAIN_MODEL=false
